# Supabase (Project Settings → Data API). The anon/publishable key is public by design (RLS protects data).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# «Continuar con Google» (optional): the Web client ID from Google Cloud. Without it the button is not shown.
VITE_GOOGLE_CLIENT_ID=
